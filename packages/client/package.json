{
  "name": "agx-client",
  "version": "0.0.0",
  "description": "Effect client for the AGX daemon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarik02-org/agx.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./AgxClient": {
      "types": "./dist/AgxClient.d.mts",
      "import": "./dist/AgxClient.mjs"
    },
    "./AgxConnection": {
      "types": "./dist/AgxConnection.d.mts",
      "import": "./dist/AgxConnection.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs"
    },
    "./error": {
      "types": "./dist/error.d.mts",
      "import": "./dist/error.mjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.mts",
      "import": "./dist/protocol.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsgo --noEmit && vp lint && vp fmt --check",
    "format": "vp fmt"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "effect": "4.0.6",
    "typescript": "^6.0.2",
    "vite-plus": "1.4.0"
  },
  "peerDependencies": {
    "effect": "^4.0.6"
  }
}
