{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tarik02-org/agx/master/schema/agx.package.schema.json",
  "$defs": {
    "BundleSpec": {
      "properties": {
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillItem"
          },
          "type": "array",
          "description": "Skill IDs, skill directory paths, or inline skill definitions."
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/InstructionsItem"
          },
          "type": "array",
          "description": "Instructions IDs, file paths, or inline instructions definitions."
        },
        "mcp": {
          "items": {
            "$ref": "#/$defs/MCPItem"
          },
          "type": "array",
          "description": "MCP server IDs or inline MCP server definitions with an id."
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/ID"
          },
          "type": "array",
          "description": "Bundle IDs."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ID": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
    },
    "Instructions": {
      "allOf": [
        {
          "not": {
            "required": [
              "ref",
              "rev"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "path": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "text"
          ]
        },
        {
          "properties": {
            "text": false
          },
          "required": [
            "git",
            "path"
          ]
        },
        {
          "properties": {
            "text": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "path"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Instructions file, relative to this file; with git, relative to the checkout."
        },
        "git": {
          "type": "string",
          "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
        },
        "ref": {
          "type": "string",
          "description": "git: branch, tag, or commit, locked at install."
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "git: full 40-character commit; pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
        },
        "text": {
          "type": "string",
          "description": "Instructions written in configuration."
        },
        "order": {
          "type": "integer",
          "description": "Sorts selected instructions, lower first, before resolution order; defaults to 0."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "InstructionsItem": {
      "oneOf": [
        {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
            },
            {
              "pattern": "^([./~]|[A-Za-z]:[\\\\/]|\\\\\\\\)"
            }
          ],
          "type": "string"
        },
        {
          "allOf": [
            {
              "not": {
                "required": [
                  "ref",
                  "rev"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "text"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            }
          ],
          "oneOf": [
            {
              "properties": {
                "path": false,
                "git": false,
                "ref": false,
                "rev": false,
                "hash": false
              },
              "required": [
                "text"
              ]
            },
            {
              "properties": {
                "text": false
              },
              "required": [
                "git",
                "path"
              ]
            },
            {
              "properties": {
                "text": false,
                "git": false,
                "ref": false,
                "rev": false,
                "hash": false
              },
              "required": [
                "path"
              ]
            }
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/ID",
              "description": "Instructions ID; defaults to the file stem of path."
            },
            "path": {
              "type": "string",
              "description": "Instructions file, relative to this file; with git, relative to the checkout."
            },
            "git": {
              "type": "string",
              "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
            },
            "ref": {
              "type": "string",
              "description": "git: branch, tag, or commit, locked at install."
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "git: full 40-character commit; pins the source without a lock entry."
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
            },
            "text": {
              "type": "string",
              "description": "Instructions written in configuration."
            },
            "order": {
              "type": "integer",
              "description": "Sorts selected instructions, lower first, before resolution order; defaults to 0."
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      ],
      "description": "An instructions ID, a file path, or an inline instructions definition."
    },
    "MCPAuth": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
        },
        {
          "$ref": "#/$defs/Secret",
          "not": {
            "required": [
              "override"
            ]
          }
        }
      ],
      "description": "http: bearer credential: oauth or keychain, none, an inline secret, or !secret ID; omitted means OAuth when the server asks for it."
    },
    "MCPItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/ID"
        },
        {
          "allOf": [
            {
              "if": {
                "required": [
                  "command"
                ]
              },
              "then": {
                "properties": {
                  "url": false,
                  "headers": false,
                  "auth": false,
                  "transport": {
                    "const": "stdio"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "url"
                ]
              },
              "then": {
                "properties": {
                  "command": false,
                  "environment": false,
                  "cwd": false,
                  "transport": {
                    "const": "http"
                  }
                }
              }
            }
          ],
          "oneOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "command"
              ]
            }
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/ID",
              "description": "MCP server ID, used for logins and native server names."
            },
            "transport": {
              "type": "string",
              "enum": [
                "stdio",
                "http"
              ],
              "description": "How to reach the server; inferred from url (http) or command (stdio)."
            },
            "command": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "stdio: server command and arguments."
            },
            "url": {
              "type": "string",
              "description": "http: server URL; http or https."
            },
            "cwd": {
              "type": "string",
              "description": "stdio: working directory; defaults to the launch directory."
            },
            "environment": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "propertyNames": {
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "type": "object",
              "description": "stdio: environment variables for the server."
            },
            "headers": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "type": "object",
              "description": "http: extra request headers."
            },
            "auth": {
              "$ref": "#/$defs/MCPAuth"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "id"
          ]
        }
      ],
      "description": "An MCP server ID, or an inline MCP server definition with an id."
    },
    "MCPServer": {
      "allOf": [
        {
          "if": {
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "url": false,
              "headers": false,
              "auth": false,
              "transport": {
                "const": "stdio"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "url"
            ]
          },
          "then": {
            "properties": {
              "command": false,
              "environment": false,
              "cwd": false,
              "transport": {
                "const": "http"
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ],
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "stdio",
            "http"
          ],
          "description": "How to reach the server; inferred from url (http) or command (stdio)."
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "stdio: server command and arguments."
        },
        "url": {
          "type": "string",
          "description": "http: server URL; http or https."
        },
        "cwd": {
          "type": "string",
          "description": "stdio: working directory; defaults to the launch directory."
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "type": "object",
          "description": "stdio: environment variables for the server."
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "type": "object",
          "description": "http: extra request headers."
        },
        "auth": {
          "$ref": "#/$defs/MCPAuth"
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Package": {
      "allOf": [
        {
          "not": {
            "required": [
              "ref",
              "rev"
            ]
          }
        },
        {
          "if": {
            "required": [
              "rev"
            ]
          },
          "then": {
            "required": [
              "git"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "git"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Local package directory."
        },
        "git": {
          "type": "string",
          "description": "Git repository URL."
        },
        "ref": {
          "type": "string",
          "description": "Git branch, tag, or commit, locked at install."
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-character Git commit; pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Content hash verified at install; pins the source without a lock entry."
        },
        "subdir": {
          "type": "string",
          "description": "Package root within the source."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Secret": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "environment",
                  "daemon_environment"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "variable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "environment",
            "daemon_environment",
            "command",
            "keychain",
            "oauth"
          ],
          "description": "How the secret is obtained."
        },
        "variable": {
          "type": "string",
          "description": "Environment variable holding the secret."
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Command whose trimmed stdout is the secret."
        },
        "issuer": {
          "type": "string",
          "description": "OAuth issuer URL; discovered when omitted."
        },
        "client_id": {
          "type": "string",
          "description": "OAuth public client ID."
        },
        "resource": {
          "type": "string",
          "description": "OAuth resource indicator."
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "OAuth scopes to request."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "Skill": {
      "allOf": [
        {
          "not": {
            "required": [
              "ref",
              "rev"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "path": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "content",
            "description"
          ]
        },
        {
          "properties": {
            "content": false,
            "name": false,
            "description": false,
            "frontmatter": false,
            "files": false
          },
          "required": [
            "git"
          ]
        },
        {
          "properties": {
            "content": false,
            "name": false,
            "description": false,
            "frontmatter": false,
            "files": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "path"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Skill directory containing SKILL.md, relative to this file; with git, relative to the checkout."
        },
        "git": {
          "type": "string",
          "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
        },
        "ref": {
          "type": "string",
          "description": "git: branch, tag, or commit, locked at install."
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "git: full 40-character commit; pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "content: native skill name, lowercase letters, digits, and hyphens; defaults to the ID's last segment."
        },
        "description": {
          "type": "string",
          "description": "content: what the skill does and when to use it."
        },
        "frontmatter": {
          "propertyNames": {
            "not": {
              "enum": [
                "name",
                "description"
              ]
            }
          },
          "type": "object",
          "description": "content: extra SKILL.md front matter, passed through."
        },
        "content": {
          "type": "string",
          "description": "SKILL.md body of a skill generated from configuration."
        },
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/SkillFile"
          },
          "propertyNames": {
            "not": {
              "pattern": "^/|(^|/)\\.{1,2}(/|$)|//|\\\\|(^|/)\\.git(/|$)|^[Ss][Kk][Ii][Ll][Ll]\\.[Mm][Dd]$"
            }
          },
          "type": "object",
          "description": "content: other files by path relative to the skill root; a trailing slash copies a directory."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SkillFile": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "properties": {
            "content": {
              "type": "string"
            },
            "executable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "content"
          ]
        }
      ],
      "description": "File text, a path to copy (ending in / for a directory), or {content, executable}."
    },
    "SkillItem": {
      "oneOf": [
        {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
            },
            {
              "pattern": "^([./~]|[A-Za-z]:[\\\\/]|\\\\\\\\)"
            }
          ],
          "type": "string"
        },
        {
          "allOf": [
            {
              "not": {
                "required": [
                  "ref",
                  "rev"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "content"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            }
          ],
          "oneOf": [
            {
              "properties": {
                "path": false,
                "git": false,
                "ref": false,
                "rev": false,
                "hash": false
              },
              "required": [
                "content",
                "description"
              ]
            },
            {
              "properties": {
                "content": false,
                "name": false,
                "description": false,
                "frontmatter": false,
                "files": false
              },
              "required": [
                "git"
              ]
            },
            {
              "properties": {
                "content": false,
                "name": false,
                "description": false,
                "frontmatter": false,
                "files": false,
                "git": false,
                "ref": false,
                "rev": false,
                "hash": false
              },
              "required": [
                "path"
              ]
            }
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/ID",
              "description": "Skill ID; defaults to the folder name of path."
            },
            "path": {
              "type": "string",
              "description": "Skill directory containing SKILL.md, relative to this file; with git, relative to the checkout."
            },
            "git": {
              "type": "string",
              "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
            },
            "ref": {
              "type": "string",
              "description": "git: branch, tag, or commit, locked at install."
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "git: full 40-character commit; pins the source without a lock entry."
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
            },
            "name": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "content: native skill name, lowercase letters, digits, and hyphens; defaults to the ID's last segment."
            },
            "description": {
              "type": "string",
              "description": "content: what the skill does and when to use it."
            },
            "frontmatter": {
              "propertyNames": {
                "not": {
                  "enum": [
                    "name",
                    "description"
                  ]
                }
              },
              "type": "object",
              "description": "content: extra SKILL.md front matter, passed through."
            },
            "content": {
              "type": "string",
              "description": "SKILL.md body of a skill generated from configuration."
            },
            "files": {
              "additionalProperties": {
                "$ref": "#/$defs/SkillFile"
              },
              "propertyNames": {
                "not": {
                  "pattern": "^/|(^|/)\\.{1,2}(/|$)|//|\\\\|(^|/)\\.git(/|$)|^[Ss][Kk][Ii][Ll][Ll]\\.[Mm][Dd]$"
                }
              },
              "type": "object",
              "description": "content: other files by path relative to the skill root; a trailing slash copies a directory."
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      ],
      "description": "A skill ID, a skill directory path, or an inline skill definition."
    },
    "Value": {
      "type": "string",
      "description": "A literal string, or !env NAME, !file PATH, or !secret ID resolved at launch."
    }
  },
  "properties": {
    "packages": {
      "additionalProperties": {
        "$ref": "#/$defs/Package"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Package sources by ID."
    },
    "skills": {
      "additionalProperties": {
        "$ref": "#/$defs/Skill"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Skills: directories containing SKILL.md, Git sources, or generated from content."
    },
    "instructions": {
      "additionalProperties": {
        "$ref": "#/$defs/Instructions"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Instructions applied to launches: files, Git sources, or text."
    },
    "mcp": {
      "additionalProperties": {
        "$ref": "#/$defs/MCPServer"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "MCP servers with the account and settings used to reach them."
    },
    "secrets": {
      "additionalProperties": {
        "$ref": "#/$defs/Secret"
      },
      "propertyNames": {
