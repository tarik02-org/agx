{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tarik02-org/agx/master/schema/agx.schema.json",
  "$defs": {
    "Args": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "type": "array"
        },
        {
          "items": {
            "oneOf": [
              {
                "items": {
                  "$ref": "#/$defs/Value"
                },
                "type": "array",
                "minItems": 1
              },
              {
                "properties": {
                  "values": {
                    "items": {
                      "$ref": "#/$defs/Value"
                    },
                    "type": "array",
                    "minItems": 1
                  },
                  "modes": {
                    "items": {
                      "enum": [
                        "app-server",
                        "exec",
                        "interactive",
                        "passthrough",
                        "print",
                        "resume",
                        "rpc"
                      ]
                    },
                    "type": "array",
                    "minItems": 1,
                    "description": "Session modes the group applies to; omit for every mode except passthrough."
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "values"
                ]
              }
            ],
            "description": "Native arguments: a list, or {values, modes} to limit them to session modes."
          },
          "type": "array"
        }
      ]
    },
    "BundleSpec": {
      "properties": {
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillItem"
          },
          "type": "array",
          "description": "Skill IDs, skill directory paths, or inline skill definitions."
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/InstructionsItem"
          },
          "type": "array",
          "description": "Instructions IDs, file paths, or inline instructions definitions."
        },
        "mcp": {
          "items": {
            "$ref": "#/$defs/MCPItem"
          },
          "type": "array",
          "description": "MCP server IDs or inline MCP server definitions with an id."
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/ID"
          },
          "type": "array",
          "description": "Bundle IDs."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Daemon": {
      "properties": {
        "lease_seconds": {
          "type": "integer",
          "minimum": 3,
          "description": "Launch lease length; defaults to 60."
        },
        "renew_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Lease renewal interval, shorter than the lease; defaults to 20."
        },
        "shutdown_grace_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "How long a stopping daemon lets MCP requests and tool calls in flight finish; defaults to 10. daemon stop and daemon restart take --timeout instead."
        },
        "autostart": {
          "type": "boolean",
          "description": "Start the daemon in the background when a command needs it; defaults to true. AGX_NO_AUTOSTART=1 overrides it."
        },
        "override": {
          "type": "boolean",
          "description": "Replace settings made by earlier fragments."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Harness": {
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "description": "Harness this definition extends."
        },
        "executable": {
          "type": "string",
          "description": "Absolute path of the native executable; may start with ~/."
        },
        "args": {
          "$ref": "#/$defs/Args",
          "description": "Native arguments inserted before the caller's: a list of strings for every session mode, or a list of groups."
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "propertyNames": {
            "pattern": "^(?![Aa][Gg][Xx]_)[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "type": "object",
          "description": "Environment variables for the harness."
        },
        "add": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources selected for this harness."
        },
        "remove": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources deselected for this harness."
        },
        "override": {
          "type": "boolean",
          "description": "Replace the definition from earlier fragments."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ID": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
    },
    "Import": {
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "glob"
          ]
        }
      ],
      "if": {
        "required": [
          "glob"
        ]
      },
      "then": {
        "properties": {
          "optional": {
            "const": false
          }
        }
      },
      "properties": {
        "path": {
          "type": "string",
          "description": "Fragment to load, relative to this file."
        },
        "glob": {
          "type": "string",
          "description": "Pattern of fragments to load in lexical order; may match nothing."
        },
        "optional": {
          "type": "boolean",
          "description": "Skip a path import whose file is missing."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Instructions": {
      "allOf": [
        {
          "not": {
            "required": [
              "ref",
              "rev"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "path": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "text"
          ]
        },
        {
          "properties": {
            "text": false
          },
          "required": [
            "git",
            "path"
          ]
        },
        {
          "properties": {
            "text": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "path"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Instructions file, relative to this file; with git, relative to the checkout."
        },
        "git": {
          "type": "string",
          "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
        },
        "ref": {
          "type": "string",
          "description": "git: branch, tag, or commit, locked at install."
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "git: full 40-character commit; pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
        },
        "text": {
          "type": "string",
          "description": "Instructions written in configuration."
        },
        "order": {
          "type": "integer",
          "description": "Sorts selected instructions, lower first, before resolution order; defaults to 0."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "InstructionsItem": {
      "oneOf": [
        {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
            },
            {
              "pattern": "^([./~]|[A-Za-z]:[\\\\/]|\\\\\\\\)"
            }
          ],
          "type": "string"
        },
        {
          "allOf": [
            {
              "not": {
                "required": [
                  "ref",
                  "rev"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "text"
                ]
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            }
          ],
          "oneOf": [
            {
              "properties": {
                "path": false,
                "git": false,
                "ref": false,
                "rev": false,
                "hash": false
              },
              "required": [
                "text"
              ]
            },
            {
              "properties": {
                "text": false
              },
              "required": [
                "git",
                "path"
              ]
            },
            {
              "properties": {
                "text": false,
                "git": false,
                "ref": false,
                "rev": false,
                "hash": false
              },
              "required": [
                "path"
              ]
            }
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/ID",
              "description": "Instructions ID; defaults to the file stem of path."
            },
            "path": {
              "type": "string",
              "description": "Instructions file, relative to this file; with git, relative to the checkout."
            },
            "git": {
              "type": "string",
              "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
            },
            "ref": {
              "type": "string",
              "description": "git: branch, tag, or commit, locked at install."
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "git: full 40-character commit; pins the source without a lock entry."
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
            },
            "text": {
              "type": "string",
              "description": "Instructions written in configuration."
            },
            "order": {
              "type": "integer",
              "description": "Sorts selected instructions, lower first, before resolution order; defaults to 0."
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      ],
      "description": "An instructions ID, a file path, or an inline instructions definition."
    },
    "MCPAuth": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
        },
        {
          "$ref": "#/$defs/Secret",
          "not": {
            "required": [
              "override"
            ]
          }
        }
      ],
      "description": "http: bearer credential: oauth or keychain, none, an inline secret, or !secret ID; omitted means OAuth when the server asks for it."
    },
    "MCPItem": {
      "oneOf": [
        {
          "$ref": "#/$defs/ID"
        },
        {
          "allOf": [
            {
              "if": {
                "required": [
                  "command"
                ]
              },
              "then": {
                "properties": {
                  "url": false,
                  "headers": false,
                  "auth": false,
                  "transport": {
                    "const": "stdio"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "url"
                ]
              },
              "then": {
                "properties": {
                  "command": false,
                  "environment": false,
                  "cwd": false,
                  "transport": {
                    "const": "http"
                  }
                }
              }
            }
          ],
          "oneOf": [
            {
              "required": [
                "url"
              ]
            },
            {
              "required": [
                "command"
              ]
            }
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/ID",
              "description": "MCP server ID, used for logins and native server names."
            },
            "transport": {
              "type": "string",
              "enum": [
                "stdio",
                "http"
              ],
              "description": "How to reach the server; inferred from url (http) or command (stdio)."
            },
            "command": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "description": "stdio: server command and arguments."
            },
            "url": {
              "type": "string",
              "description": "http: server URL; http or https."
            },
            "cwd": {
              "type": "string",
              "description": "stdio: working directory; defaults to the launch directory."
            },
            "environment": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "propertyNames": {
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
              },
              "type": "object",
              "description": "stdio: environment variables for the server."
            },
            "headers": {
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              },
              "type": "object",
              "description": "http: extra request headers."
            },
            "auth": {
              "$ref": "#/$defs/MCPAuth"
            },
            "description": {
              "type": "string",
              "description": "What the server offers, shown by agx mcp tools."
            },
            "load": {
              "type": "string",
              "enum": [
                "native",
                "on_demand"
              ],
              "description": "native: in the harness's tool list (default); on_demand: reached with agx mcp call."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "id"
          ]
        }
      ],
      "description": "An MCP server ID, or an inline MCP server definition with an id."
    },
    "MCPServer": {
      "allOf": [
        {
          "if": {
            "required": [
              "command"
            ]
          },
          "then": {
            "properties": {
              "url": false,
              "headers": false,
              "auth": false,
              "transport": {
                "const": "stdio"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "url"
            ]
          },
          "then": {
            "properties": {
              "command": false,
              "environment": false,
              "cwd": false,
              "transport": {
                "const": "http"
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "command"
          ]
        }
      ],
      "properties": {
        "transport": {
          "type": "string",
          "enum": [
            "stdio",
            "http"
          ],
          "description": "How to reach the server; inferred from url (http) or command (stdio)."
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "stdio: server command and arguments."
        },
        "url": {
          "type": "string",
          "description": "http: server URL; http or https."
        },
        "cwd": {
          "type": "string",
          "description": "stdio: working directory; defaults to the launch directory."
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "type": "object",
          "description": "stdio: environment variables for the server."
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "type": "object",
          "description": "http: extra request headers."
        },
        "auth": {
          "$ref": "#/$defs/MCPAuth"
        },
        "description": {
          "type": "string",
          "description": "What the server offers, shown by agx mcp tools."
        },
        "load": {
          "type": "string",
          "enum": [
            "native",
            "on_demand"
          ],
          "description": "native: in the harness's tool list (default); on_demand: reached with agx mcp call."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Package": {
      "allOf": [
        {
          "not": {
            "required": [
              "ref",
              "rev"
            ]
          }
        },
        {
          "if": {
            "required": [
              "rev"
            ]
          },
          "then": {
            "required": [
              "git"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "git"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Local package directory."
        },
        "git": {
          "type": "string",
          "description": "Git repository URL."
        },
        "ref": {
          "type": "string",
          "description": "Git branch, tag, or commit, locked at install."
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full 40-character Git commit; pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Content hash verified at install; pins the source without a lock entry."
        },
        "subdir": {
          "type": "string",
          "description": "Package root within the source."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ScopeSpec": {
      "properties": {
        "directory": {
          "type": "string",
          "description": "Directory the rule applies to, with its descendants; omitted, the rule applies everywhere, before every directory rule."
        },
        "harnesses": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Apply only to launches of these harnesses or definitions based on them."
        },
        "add": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources to select."
        },
        "remove": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources to deselect."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Secret": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "environment",
                  "daemon_environment"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "variable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sops"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "file"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "environment",
            "daemon_environment",
            "command",
            "keychain",
            "oauth",
            "sops"
          ],
          "description": "How the secret is obtained."
        },
        "variable": {
          "type": "string",
          "description": "Environment variable holding the secret."
        },
        "command": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Command whose trimmed stdout is the secret."
        },
        "file": {
          "type": "string",
          "description": "sops: encrypted file, relative to the declaring fragment."
        },
        "key": {
          "$ref": "#/$defs/SecretKey",
          "description": "sops: dotted key path or list of segments to extract; omit to read the whole file."
        },
        "age_key": {
          "$ref": "#/$defs/Value",
          "description": "sops: age identity passed to sops as SOPS_AGE_KEY: !secret ID, !env NAME, or !file PATH."
        },
        "issuer": {
          "type": "string",
          "description": "OAuth issuer URL; discovered when omitted."
        },
        "client_id": {
          "type": "string",
          "description": "OAuth public client ID."
        },
        "resource": {
          "type": "string",
          "description": "OAuth resource indicator."
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "OAuth scopes to request."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "SecretKey": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[^.]+(\\.[^.]+)*$"
        },
        {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "SelectionSpec": {
      "properties": {
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillItem"
          },
          "type": "array",
          "description": "Skill IDs, skill directory paths, or inline skill definitions."
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/InstructionsItem"
          },
          "type": "array",
          "description": "Instructions IDs, file paths, or inline instructions definitions."
        },
        "mcp": {
          "items": {
            "$ref": "#/$defs/MCPItem"
          },
          "type": "array",
          "description": "MCP server IDs or inline MCP server definitions with an id."
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/ID"
          },
          "type": "array",
          "description": "Bundle IDs."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Skill": {
      "allOf": [
        {
          "not": {
            "required": [
              "ref",
              "rev"
            ]
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "path": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "content",
            "description"
          ]
        },
        {
          "properties": {
            "content": false,
            "name": false,
            "description": false,
            "frontmatter": false,
            "files": false
          },
          "required": [
            "git"
          ]
        },
        {
          "properties": {
            "content": false,
            "name": false,
            "description": false,
            "frontmatter": false,
            "files": false,
            "git": false,
            "ref": false,
            "rev": false,
            "hash": false
          },
          "required": [
            "path"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "Skill directory containing SKILL.md, relative to this file; with git, relative to the checkout."
        },
        "git": {
          "type": "string",
          "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
        },
        "ref": {
          "type": "string",
          "description": "git: branch, tag, or commit, locked at install."
        },
        "rev": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "git: full 40-character commit; pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
