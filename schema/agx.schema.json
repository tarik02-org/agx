{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tarik02-org/agx/master/schema/agx.schema.json",
  "$defs": {
    "Args": {
      "if": {
        "items": {
          "type": "string"
        }
      },
      "then": {
        "items": {
          "$ref": "#/$defs/Value"
        }
      },
      "else": {
        "items": {
          "properties": {
            "values": {
              "items": {
                "$ref": "#/$defs/Value"
              },
              "type": "array",
              "minItems": 1
            },
            "modes": {
              "items": {
                "enum": [
                  "app-server",
                  "exec",
                  "interactive",
                  "passthrough",
                  "print",
                  "resume",
                  "rpc"
                ]
              },
              "type": "array",
              "minItems": 1,
              "description": "Session modes the group applies to; omit for every mode except passthrough."
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "values"
          ],
          "description": "Native arguments limited to session modes."
        }
      },
      "type": "array"
    },
    "BundleSpec": {
      "properties": {
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillItem"
          },
          "type": "array",
          "description": "Skill IDs, skill directory paths, or inline skill definitions."
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/InstructionsItem"
          },
          "type": "array",
          "description": "Instructions IDs, file paths, or inline instructions definitions."
        },
        "mcp": {
          "items": {
            "$ref": "#/$defs/MCPItem"
          },
          "type": "array",
          "description": "MCP server IDs or inline MCP server definitions with an id."
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/ID"
          },
          "type": "array",
          "description": "Bundle IDs."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Daemon": {
      "properties": {
        "lease_seconds": {
          "type": "integer",
          "minimum": 3,
          "description": "Launch lease length; defaults to 60."
        },
        "renew_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Lease renewal interval, shorter than the lease; defaults to 20."
        },
        "autostart": {
          "type": "boolean",
          "description": "Start the daemon in the background when a command needs it; defaults to true. AGX_NO_AUTOSTART=1 overrides it."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Harness": {
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "description": "Harness this definition extends."
        },
        "executable": {
          "type": "string",
          "description": "Absolute path of the native executable; may start with ~/."
        },
        "args": {
          "$ref": "#/$defs/Args",
          "description": "Native arguments inserted before the caller's: a list of strings for every session mode, or a list of {values, modes} groups."
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "propertyNames": {
            "not": {
              "pattern": "^[Aa][Gg][Xx]_"
            },
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "type": "object",
          "description": "Environment variables for the harness."
        },
        "add": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources selected for this harness."
        },
        "remove": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources deselected for this harness."
        },
        "hidden": {
          "type": "boolean",
          "description": "Leave this harness out of the launcher's new-session list; it still runs by name. Not inherited."
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "description": "Native settings in the harness's own schema: Codex config.toml keys, Claude Code settings.json keys."
        },
        "override": {
          "type": "boolean",
          "description": "Replace the definition from earlier fragments."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ID": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
    },
    "Instructions": {
      "if": {
        "required": [
          "text"
        ]
      },
      "then": {
        "properties": {
          "path": false,
          "git": false,
          "ref": false,
          "hash": false
        }
      },
      "else": {
        "if": {
          "required": [
            "git"
          ]
        },
        "else": {
          "properties": {
            "ref": false,
            "hash": false
          },
          "required": [
            "path"
          ]
        },
        "required": [
          "path"
        ]
      },
      "properties": {
        "path": {
          "type": "string",
          "description": "Instructions file, relative to this file; with git, relative to the checkout."
        },
        "git": {
          "type": "string",
          "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
        },
        "ref": {
          "type": "string",
          "description": "git: branch, tag, or commit, locked at install; a full 40-character commit pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
        },
        "text": {
          "type": "string",
          "description": "Instructions written in configuration."
        },
        "order": {
          "type": "integer",
          "description": "Sorts selected instructions, lower first, before resolution order; defaults to 0."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "InstructionsItem": {
      "if": {
        "type": "string"
      },
      "then": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
          },
          {
            "pattern": "^([./~]|[A-Za-z]:[\\\\/]|\\\\\\\\)"
          }
        ],
        "type": "string"
      },
      "else": {
        "allOf": [
          {
            "if": {
              "required": [
                "text"
              ]
            },
            "then": {
              "required": [
                "id"
              ]
            }
          }
        ],
        "if": {
          "required": [
            "text"
          ]
        },
        "then": {
          "properties": {
            "path": false,
            "git": false,
            "ref": false,
            "hash": false
          }
        },
        "else": {
          "if": {
            "required": [
              "git"
            ]
          },
          "else": {
            "properties": {
              "ref": false,
              "hash": false
            },
            "required": [
              "path"
            ]
          },
          "required": [
            "path"
          ]
        },
        "properties": {
          "id": {
            "$ref": "#/$defs/ID",
            "description": "Instructions ID; defaults to the file stem of path."
          },
          "path": {
            "type": "string",
            "description": "Instructions file, relative to this file; with git, relative to the checkout."
          },
          "git": {
            "type": "string",
            "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
          },
          "ref": {
            "type": "string",
            "description": "git: branch, tag, or commit, locked at install; a full 40-character commit pins the source without a lock entry."
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
          },
          "text": {
            "type": "string",
            "description": "Instructions written in configuration."
          },
          "order": {
            "type": "integer",
            "description": "Sorts selected instructions, lower first, before resolution order; defaults to 0."
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "description": "An instructions ID, a file path, or an inline instructions definition."
    },
    "MCPAuth": {
      "if": {
        "type": "string"
      },
      "then": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "else": {
        "$ref": "#/$defs/Secret",
        "not": {
          "required": [
            "override"
          ]
        }
      },
      "description": "http: bearer credential: oauth or keychain, none, an inline secret, or !secret ID; omitted means OAuth when the server asks for it."
    },
    "MCPItem": {
      "if": {
        "type": "string"
      },
      "then": {
        "$ref": "#/$defs/ID"
      },
      "else": {
        "if": {
          "required": [
            "url"
          ]
        },
        "then": {
          "properties": {
            "command": false,
            "environment": false,
            "cwd": false,
            "share": false
          }
        },
        "else": {
          "properties": {
            "headers": false,
            "auth": false
          },
          "required": [
            "command"
          ]
        },
        "properties": {
          "id": {
            "$ref": "#/$defs/ID",
            "description": "MCP server ID, used for logins and native server names."
          },
          "command": {
            "prefixItems": [
              {
                "minLength": 1
              }
            ],
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "description": "stdio: server command and arguments."
          },
          "url": {
            "type": "string",
            "description": "http: server URL; http or https."
          },
          "cwd": {
            "type": "string",
            "description": "stdio: working directory; defaults to the launch directory."
          },
          "environment": {
            "additionalProperties": {
              "$ref": "#/$defs/Value"
            },
            "propertyNames": {
              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
            },
            "type": "object",
            "description": "stdio: environment variables for the server."
          },
          "headers": {
            "additionalProperties": {
              "$ref": "#/$defs/Value"
            },
            "type": "object",
            "description": "http: extra request headers."
          },
          "auth": {
            "$ref": "#/$defs/MCPAuth"
          },
          "description": {
            "type": "string",
            "description": "What the server offers, shown by agx mcp tools."
          },
          "load": {
            "type": "string",
            "enum": [
              "native",
              "on_demand"
            ],
            "description": "native: in the harness's tool list (default); on_demand: reached with agx mcp call."
          },
          "share": {
            "$ref": "#/$defs/MCPShare"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ]
      },
      "description": "An MCP server ID, or an inline MCP server definition with an id."
    },
    "MCPServer": {
      "if": {
        "required": [
          "url"
        ]
      },
      "then": {
        "properties": {
          "command": false,
          "environment": false,
          "cwd": false,
          "share": false
        }
      },
      "else": {
        "properties": {
          "headers": false,
          "auth": false
        },
        "required": [
          "command"
        ]
      },
      "properties": {
        "command": {
          "prefixItems": [
            {
              "minLength": 1
            }
          ],
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1,
          "description": "stdio: server command and arguments."
        },
        "url": {
          "type": "string",
          "description": "http: server URL; http or https."
        },
        "cwd": {
          "type": "string",
          "description": "stdio: working directory; defaults to the launch directory."
        },
        "environment": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "propertyNames": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
          },
          "type": "object",
          "description": "stdio: environment variables for the server."
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "type": "object",
          "description": "http: extra request headers."
        },
        "auth": {
          "$ref": "#/$defs/MCPAuth"
        },
        "description": {
          "type": "string",
          "description": "What the server offers, shown by agx mcp tools."
        },
        "load": {
          "type": "string",
          "enum": [
            "native",
            "on_demand"
          ],
          "description": "native: in the harness's tool list (default); on_demand: reached with agx mcp call."
        },
        "share": {
          "$ref": "#/$defs/MCPShare"
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "MCPShare": {
      "if": {
        "type": "string"
      },
      "then": {
        "enum": [
          "none",
          "directory",
          "repo",
          "global"
        ]
      },
      "else": {
        "properties": {
          "type": {
            "enum": [
              "none",
              "directory",
              "repo",
              "global"
            ]
          },
          "idle": {
            "type": "string",
            "description": "How long the process stays after its last session, such as 30m; default 5m."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type"
        ]
      },
      "description": "stdio: none gives each harness session its own process (default); directory, repo, or global share one process per launch directory, repository root, or everywhere. {type, idle} also sets how long it stays after its last session."
    },
    "Package": {
      "if": {
        "required": [
          "git"
        ]
      },
      "then": {
        "properties": {
          "path": false
        }
      },
      "else": {
        "properties": {
          "ref": false
        },
        "required": [
          "path"
        ]
      },
      "properties": {
        "path": {
          "type": "string",
          "description": "Local package directory."
        },
        "git": {
          "type": "string",
          "description": "Git repository URL."
        },
        "ref": {
          "type": "string",
          "description": "Git branch, tag, or commit, locked at install; a full 40-character commit pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Content hash verified at install; pins the source without a lock entry."
        },
        "subdir": {
          "type": "string",
          "description": "Package root within the source."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ScopeSpec": {
      "properties": {
        "directory": {
          "type": "string",
          "description": "Directory the rule applies to, with its descendants; omitted, the rule applies everywhere, before every directory rule."
        },
        "harnesses": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Apply only to launches of these harnesses or definitions based on them."
        },
        "add": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources to select."
        },
        "remove": {
          "$ref": "#/$defs/SelectionSpec",
          "description": "Resources to deselect."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Secret": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sops"
              }
            },
            "required": [
              "kind"
            ]
          },
          "else": {
            "properties": {
              "key": false,
              "age_key": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "file",
                  "sops"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "else": {
            "properties": {
              "file": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "environment",
                  "daemon_environment"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "variable"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "file",
                  "sops"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "file"
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "environment",
            "daemon_environment",
            "command",
            "file",
            "keychain",
            "oauth",
            "sops"
          ],
          "description": "How the secret is obtained."
        },
        "variable": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "description": "Environment variable holding the secret."
        },
        "command": {
          "prefixItems": [
            {
              "minLength": 1
            }
          ],
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1,
          "description": "Command whose trimmed stdout is the secret."
        },
        "file": {
          "type": "string",
          "description": "sops: encrypted file; file: file holding the secret. Relative to the declaring fragment."
        },
        "key": {
          "$ref": "#/$defs/SecretKey",
          "description": "sops: dotted key path or list of segments to extract; omit to read the whole file."
        },
        "age_key": {
          "$ref": "#/$defs/Value",
          "description": "sops: age identity passed to sops as SOPS_AGE_KEY: !secret ID, !env NAME, or !file PATH."
        },
        "issuer": {
          "type": "string",
          "description": "OAuth issuer URL; discovered when omitted."
        },
        "client_id": {
          "type": "string",
          "description": "OAuth public client ID."
        },
        "resource": {
          "type": "string",
          "description": "OAuth resource indicator."
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "OAuth scopes to request."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind"
      ]
    },
    "SecretKey": {
      "if": {
        "type": "string"
      },
      "then": {
        "pattern": "^[^.]+(\\.[^.]+)*$"
      },
      "else": {
        "items": {
          "type": "string",
          "minLength": 1
        },
        "type": "array",
        "minItems": 1
      }
    },
    "SelectionSpec": {
      "properties": {
        "skills": {
          "items": {
            "$ref": "#/$defs/SkillItem"
          },
          "type": "array",
          "description": "Skill IDs, skill directory paths, or inline skill definitions."
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/InstructionsItem"
          },
          "type": "array",
          "description": "Instructions IDs, file paths, or inline instructions definitions."
        },
        "mcp": {
          "items": {
            "$ref": "#/$defs/MCPItem"
          },
          "type": "array",
          "description": "MCP server IDs or inline MCP server definitions with an id."
        },
        "bundles": {
          "items": {
            "$ref": "#/$defs/ID"
          },
          "type": "array",
          "description": "Bundle IDs."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Settings": {
      "type": "object",
      "description": "Native settings, in the harness's own configuration schema: Codex config.toml keys, Claude Code settings.json keys. null removes an inherited key. !file reads a file; !secret and !env are not allowed."
    },
    "Skill": {
      "if": {
        "required": [
          "content"
        ]
      },
      "then": {
        "properties": {
          "path": false,
          "git": false,
          "ref": false,
          "hash": false
        },
        "required": [
          "description"
        ]
      },
      "else": {
        "if": {
          "required": [
            "git"
          ]
        },
        "else": {
          "properties": {
            "ref": false,
            "hash": false
          },
          "required": [
            "path"
          ]
        },
        "properties": {
          "name": false,
          "description": false,
          "frontmatter": false,
          "files": false
        }
      },
      "properties": {
        "path": {
          "type": "string",
          "description": "Skill directory containing SKILL.md, relative to this file; with git, relative to the checkout."
        },
        "git": {
          "type": "string",
          "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
        },
        "ref": {
          "type": "string",
          "description": "git: branch, tag, or commit, locked at install; a full 40-character commit pins the source without a lock entry."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "content: native skill name, lowercase letters, digits, and hyphens; defaults to the ID's last segment."
        },
        "description": {
          "type": "string",
          "description": "content: what the skill does and when to use it."
        },
        "frontmatter": {
          "propertyNames": {
            "not": {
              "enum": [
                "name",
                "description"
              ]
            }
          },
          "type": "object",
          "description": "content: extra SKILL.md front matter, passed through."
        },
        "content": {
          "type": "string",
          "description": "SKILL.md body of a skill generated from configuration."
        },
        "files": {
          "additionalProperties": {
            "$ref": "#/$defs/SkillFile"
          },
          "propertyNames": {
            "not": {
              "pattern": "^/|(^|/)\\.{1,2}(/|$)|//|\\\\|(^|/)\\.git(/|$)|^[Ss][Kk][Ii][Ll][Ll]\\.[Mm][Dd]$"
            },
            "minLength": 1
          },
          "type": "object",
          "description": "content: other files by path relative to the skill root; a trailing slash copies a directory."
        },
        "override": {
          "type": "boolean",
          "description": "Replace an existing definition."
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "SkillFile": {
      "if": {
        "required": [
          "content"
        ]
      },
      "then": {
        "properties": {
          "path": false
        }
      },
      "else": {
        "properties": {
          "executable": false
        },
        "required": [
          "path"
        ]
      },
      "properties": {
        "content": {
          "type": "string"
        },
        "executable": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "File to copy, relative to this file; ending in / copies a directory."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "{content, executable} for file text, or {path} to copy a file or directory."
    },
    "SkillItem": {
      "if": {
        "type": "string"
      },
      "then": {
        "anyOf": [
          {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
          },
          {
            "pattern": "^([./~]|[A-Za-z]:[\\\\/]|\\\\\\\\)"
          }
        ],
        "type": "string"
      },
      "else": {
        "allOf": [
          {
            "if": {
              "required": [
                "content"
              ]
            },
            "then": {
              "required": [
                "id"
              ]
            }
          }
        ],
        "if": {
          "required": [
            "content"
          ]
        },
        "then": {
          "properties": {
            "path": false,
            "git": false,
            "ref": false,
            "hash": false
          },
          "required": [
            "description"
          ]
        },
        "else": {
          "if": {
            "required": [
              "git"
            ]
          },
          "else": {
            "properties": {
              "ref": false,
              "hash": false
            },
            "required": [
              "path"
            ]
          },
          "properties": {
            "name": false,
            "description": false,
            "frontmatter": false,
            "files": false
          }
        },
        "properties": {
          "id": {
            "$ref": "#/$defs/ID",
            "description": "Skill ID; defaults to the folder name of path."
          },
          "path": {
            "type": "string",
            "description": "Skill directory containing SKILL.md, relative to this file; with git, relative to the checkout."
          },
          "git": {
            "type": "string",
            "description": "Git repository holding the resource, fetched like a package; path is then relative to the checkout."
          },
          "ref": {
            "type": "string",
            "description": "git: branch, tag, or commit, locked at install; a full 40-character commit pins the source without a lock entry."
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "git: content hash of the checkout, verified at install; pins the source without a lock entry."
          },
          "name": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "content: native skill name, lowercase letters, digits, and hyphens; defaults to the ID's last segment."
          },
          "description": {
            "type": "string",
            "description": "content: what the skill does and when to use it."
          },
          "frontmatter": {
            "propertyNames": {
              "not": {
                "enum": [
                  "name",
                  "description"
                ]
              }
            },
            "type": "object",
            "description": "content: extra SKILL.md front matter, passed through."
          },
          "content": {
            "type": "string",
            "description": "SKILL.md body of a skill generated from configuration."
          },
          "files": {
            "additionalProperties": {
              "$ref": "#/$defs/SkillFile"
            },
            "propertyNames": {
              "not": {
                "pattern": "^/|(^|/)\\.{1,2}(/|$)|//|\\\\|(^|/)\\.git(/|$)|^[Ss][Kk][Ii][Ll][Ll]\\.[Mm][Dd]$"
              },
              "minLength": 1
            },
            "type": "object",
            "description": "content: other files by path relative to the skill root; a trailing slash copies a directory."
          }
        },
        "additionalProperties": false,
        "type": "object"
      },
      "description": "A skill ID, a skill directory path, or an inline skill definition."
    },
    "Value": {
      "type": "string",
      "description": "A literal string, or !env NAME, !file PATH, or !secret ID resolved at launch."
    }
  },
  "properties": {
    "imports": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "description": "Fragments loaded before this file, relative to it: paths, which must exist, or glob patterns, which may match nothing, loaded in lexical order."
    },
    "packages": {
      "additionalProperties": {
        "$ref": "#/$defs/Package"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Package sources by ID."
    },
    "skills": {
      "additionalProperties": {
        "$ref": "#/$defs/Skill"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Skills: directories containing SKILL.md, Git sources, or generated from content."
    },
    "instructions": {
      "additionalProperties": {
        "$ref": "#/$defs/Instructions"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Instructions applied to launches: files, Git sources, or text."
    },
    "mcp": {
      "additionalProperties": {
        "$ref": "#/$defs/MCPServer"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "MCP servers with the account and settings used to reach them."
    },
    "secrets": {
      "additionalProperties": {
        "$ref": "#/$defs/Secret"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "How credentials are obtained."
    },
    "bundles": {
      "additionalProperties": {
        "$ref": "#/$defs/BundleSpec"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)*$"
      },
      "type": "object",
      "description": "Named selections of resources."
    },
    "scopes": {
      "items": {
        "$ref": "#/$defs/ScopeSpec"
      },
      "type": "array",
      "description": "Directory rules that add or remove resources."
    },
    "harnesses": {
      "additionalProperties": {
        "$ref": "#/$defs/Harness"
      },
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
      },
      "type": "object",
      "description": "Built-in harness customizations and new definitions."
    },
    "daemon": {
      "$ref": "#/$defs/Daemon",
      "description": "Launch lease timing and automatic daemon startup."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "agx configuration fragment"
}
