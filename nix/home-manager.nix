# Home Manager module for agx: installs the CLI, renders `programs.agx.settings`
# into a drop-in under agx's configuration directory (and its `daemon` settings
# into the root file), keeps agx's shims in sync, and can install links that run
# built-in harnesses through agx.
self:
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.programs.agx;
  yamlFormat = pkgs.formats.yaml { };
  system = pkgs.stdenv.hostPlatform.system;

  # Tagged values travel through JSON as `{ __agxTag, value }` objects and
  # leave the YAML renderer as tagged scalars such as `!secret <id>`.
  tags = rec {
    tag = kind: value: {
      __agxTag = kind;
      inherit value;
    };
    secret = tag "secret";
    env = tag "env";
    file = tag "file";
  };

  harnessLinks = lib.attrNames (lib.filterAttrs (_: harness: harness.link) cfg.harnesses);

  pinnedHarnesses = lib.mapAttrs (_: harness: {
    executable = lib.mkDefault (lib.getExe harness.package);
  }) (lib.filterAttrs (_: harness: harness.package != null) cfg.harnesses);

  dropInPath = "${cfg.configDirectory}/agx.d/${cfg.dropInName}.yaml";
  rootPath = "${cfg.configDirectory}/agx.yaml";
  configRoot = "${config.home.homeDirectory}/${rootPath}";
  definitions = removeAttrs cfg.settings [ "daemon" ];
  root = yamlFormat.generate "agx.yaml" {
    fragments = [ "agx.d/*.yaml" ];
    inherit (cfg.settings) daemon;
  };
  # agx shims install writes here, given this XDG_DATA_HOME.
  shimsDirectory = "${config.xdg.dataHome}/agx/shims";

  dropIn =
    pkgs.runCommand "agx-${cfg.dropInName}.yaml"
      {
        nativeBuildInputs = [ pkgs.yq-go ] ++ lib.optional cfg.validate cfg.package;
        json = (pkgs.formats.json { }).generate "agx-${cfg.dropInName}.json" definitions;
      }
      (
        ''
          yq --prettyPrint --output-format yaml \
          '(.. | select(tag == "!!map" and has("__agxTag"))) |= (.__agxTag as $kind | .value | . tag = "!" + $kind)
            | . head_comment = "Generated by Home Manager from programs.agx.settings. Edit another drop-in instead."' \
          "$json" > $out
        ''
        + lib.optionalString cfg.validate ''
          # A scratch home, so that ~/ in paths expands to somewhere writable.
          export HOME="$TMPDIR/home"
          mkdir -p "$HOME" "$TMPDIR/config/agx.d"
          cp $out "$TMPDIR/config/agx.d/${cfg.dropInName}.yaml"
          ${lib.optionalString (cfg.settings ? daemon) ''cp ${root} "$TMPDIR/config/agx.yaml"''}
          AGX_CONFIG="$TMPDIR/config/agx.yaml" AGX_CACHE="$TMPDIR/cache" AGX_NO_AUTOSTART=1 \
            agx --color never config validate
        ''
      );

  # Links named after harnesses run agx as that harness, shadowing the native
  # command on PATH; agx finds the native one by skipping itself, or through a
  # pinned `executable`.
  links = pkgs.runCommand "agx-harness-links" { } ''
    mkdir -p $out/bin
    ${lib.concatMapStringsSep "\n" (
      name: "ln -s ${lib.getExe cfg.package} $out/bin/${lib.escapeShellArg name}"
    ) harnessLinks}
  '';

  harnessType = lib.types.submodule {
    options = {
      package = lib.mkOption {
        type = lib.types.nullOr lib.types.package;
        default = null;
        example = lib.literalExpression "pkgs.codex";
        description = ''
          Package of the harness's native executable. When set, the drop-in pins
          `harnesses.<name>.executable` to its main program. The package itself
          is not installed.
        '';
      };

      link = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Install a command named after the harness that links to agx, so
          running it launches the harness through agx. It takes priority over
          a native command of the same name in the Home Manager profile.
        '';
      };
    };
  };
in
{
  options.programs.agx = {
    enable = lib.mkEnableOption "agx, directory-scoped skills, MCP servers, and instructions for coding agents";

    package = lib.mkOption {
      type = lib.types.package;
      default = self.packages.${system}.agx or (pkgs.callPackage ../package.nix { });
      defaultText = lib.literalExpression "agx.packages.\${system}.agx";
      description = "The agx package.";
    };

    settings = lib.mkOption {
      inherit (yamlFormat) type;
      default = { };
      example = lib.literalExpression ''
        {
          secrets.github = { kind = "command"; command = [ "gh" "auth" "token" ]; };
          mcp.github = {
            url = "https://api.githubcopilot.com/mcp/";
            auth = config.lib.agx.secret "github";
          };
          instructions.style.text = "Prefer small commits.";
        }
      '';
      description = ''
        agx configuration written to `agx.d/<dropInName>.yaml` in agx's
        configuration directory; see agx's docs/configuration.md. `daemon`
        goes to the root `agx.yaml` instead, which then lists
        `agx.d/*.yaml` and nothing else. Express YAML
        tags such as `!secret github` with `config.lib.agx.secret "github"`,
        `config.lib.agx.env`, `config.lib.agx.file`, or
        `config.lib.agx.tag "<kind>" value`.
      '';
    };

    dropInName = lib.mkOption {
      type = lib.types.str;
      default = "10-home-manager";
      description = "Name of the drop-in file in `agx.d`, without `.yaml`.";
    };

    configDirectory = lib.mkOption {
      type = lib.types.str;
      default =
        if pkgs.stdenv.hostPlatform.isDarwin && !config.xdg.enable then
          "Library/Application Support/agx"
        else
          "${lib.removePrefix "${config.home.homeDirectory}/" config.xdg.configHome}/agx";
      defaultText = lib.literalExpression ''
        "Library/Application Support/agx" on macOS without xdg.enable,
        otherwise xdg.configHome + "/agx", relative to the home directory
      '';
      description = ''
        agx's configuration directory relative to the home directory. agx uses
        `$XDG_CONFIG_HOME/agx`, which Home Manager exports only with
        `xdg.enable`; without it macOS falls back to Application Support.
      '';
    };

    validate = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Check the drop-in with `agx config validate` at build time. `~/` points
        at an empty scratch home there, so disable this when the settings refer
        to files that only exist at run time.
      '';
    };

    shims = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Run `agx shims install` at activation, so every harness definition is
          a command, and put the shims directory on PATH. A failure only warns.
        '';
      };
    };

    harnesses = lib.mkOption {
      type = lib.types.attrsOf harnessType;
      default = { };
      example = lib.literalExpression ''
        {
          codex.package = pkgs.codex;
          claude.package = pkgs.claude-code;
        }
      '';
      description = ''
        Built-in harnesses (such as `codex`, `claude`, `pi`) to run through agx
        under their own name, optionally with their native executable pinned.
      '';
    };
  };

  config = lib.mkMerge [
    { lib.agx = tags; }

    (lib.mkIf cfg.enable {
      programs.agx.settings = lib.mkIf (pinnedHarnesses != { }) { harnesses = pinnedHarnesses; };

      home.packages = [ cfg.package ] ++ lib.optional (harnessLinks != [ ]) (lib.hiPrio links);

      home.file.${dropInPath} = lib.mkIf (definitions != { }) { source = dropIn; };

      home.file.${rootPath} = lib.mkIf (cfg.settings ? daemon) { source = root; };

      # agx loads `agx.d/*.yaml` only when no root file exists or the root
      # file lists them itself.
      home.activation.agxCheckFragments = lib.mkIf (definitions != { }) (
        lib.hm.dag.entryAfter [ "writeBoundary" ] ''
          agx_root=${lib.escapeShellArg configRoot}
          if [[ -e "$agx_root" ]] && ! ${lib.getExe pkgs.gnugrep} -q 'agx\.d/' "$agx_root"; then
            warnEcho "$agx_root does not list agx.d/*.yaml; add 'fragments: [agx.d/*.yaml]' to load ${dropInPath}"
          fi
        ''
      );

      home.sessionPath = lib.mkIf cfg.shims.enable [ shimsDirectory ];

      # Shims run agx through the profile link, which outlives this
      # generation's store path. A broken agx.yaml leaves the previous shims in
      # place rather than failing activation.
      home.activation.agxInstallShims = lib.mkIf cfg.shims.enable (
        lib.hm.dag.entryAfter [ "linkGeneration" "installPackages" ] ''
          if [[ -v DRY_RUN ]]; then
            verboseEcho "Would install agx shims in ${shimsDirectory}"
          else
            agx_bin=${lib.escapeShellArg "${config.home.profileDirectory}/bin/agx"}
            [[ -x "$agx_bin" ]] || agx_bin=${lib.getExe cfg.package}
            # AGX_CONFIG, unlike --config, accepts a root file that does not exist.
            if agx_shims="$(AGX_CONFIG=${lib.escapeShellArg configRoot} \
              XDG_DATA_HOME=${lib.escapeShellArg config.xdg.dataHome} "$agx_bin" --color never \
              shims install --json 2>/dev/null)"; then
              ${lib.getExe pkgs.jq} -r '.data.changes[]
                | select(.action != "unchanged")
                | "agx shims: \(.action) \(.name)"' <<< "$agx_shims"
            else
              warnEcho "agx shims install failed; shims may be stale: $(
                ${lib.getExe pkgs.jq} -r '.error.message // "unknown error"' <<< "$agx_shims" 2>/dev/null || echo "$agx_shims"
              )"
            fi
          fi
        ''
      );
    })
  ];
}
